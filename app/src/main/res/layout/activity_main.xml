<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DECAA5"
    android:padding="@dimen/screen_padding"
    tools:context=".MainActivity">

    <!-- Title -->

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Дневник настроения"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#5C4033"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Log mood button -->

    <Button
        android:id="@+id/button_log"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Добавить запись..."
        android:textSize="16sp"
        android:textColor="#FDF5E6"
        android:backgroundTint="#C97B63"
        app:layout_constraintTop_toBottomOf="@id/title_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Notes button -->

    <Button
        android:id="@+id/button_notes_list"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Просмотреть записи"
        android:textSize="16sp"
        android:textColor="#C97B63"
        android:backgroundTint="#FDF5E6"
        app:cornerRadius="16dp"
        app:strokeColor="#60C97B63"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@id/button_log"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Statistics title -->

    <TextView
        android:id="@+id/heatmap_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Статистика настроения"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#5C4033"
        app:layout_constraintTop_toBottomOf="@id/button_notes_list"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Heatmap -->

    <HorizontalScrollView
        android:id="@+id/heatmap_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:padding="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/heatmap_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.example.projectmood.stats.HeatmapView
            android:id="@+id/heatmap_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp" />

    </HorizontalScrollView>

    <!-- Goals section -->

    <TextView
        android:id="@+id/goals_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Цели на день:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#5C4033"
        app:layout_constraintTop_toBottomOf="@id/heatmap_scroll"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Goals list -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/goals_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/goals_title"
        app:layout_constraintBottom_toTopOf="@id/button_add_goal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Add goal button -->

    <Button
        android:id="@+id/button_add_goal"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:text="+ Добавить цель"
        android:textSize="16sp"
        android:textColor="#C97B63"
        android:backgroundTint="#FDF5E6"
        app:cornerRadius="16dp"
        app:strokeColor="#60C97B63"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>