<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DECAA5"
    android:padding="@dimen/screen_padding"
    tools:context=".LogMoodActivity">

    <!-- Back Button -->

    <ImageButton
        android:id="@+id/back_arrow"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_search"
        android:backgroundTint="#FDF5E6"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title -->

    <TextView
        android:id="@+id/title_log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="Новая запись"
        android:textColor="#5C4033"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/back_arrow"
        app:layout_constraintBottom_toBottomOf="@id/back_arrow"
        app:layout_constraintStart_toEndOf="@id/back_arrow" />

    <!-- Note Input -->

    <EditText
        android:id="@+id/note_text"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_search"
        android:gravity="top|start"
        android:hint="Как прошёл ваш день?"
        android:padding="16dp"
        android:textColor="#5C4033"
        android:textColorHint="#995C4033"
        android:textSize="16sp"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toBottomOf="@id/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tags Label -->

    <TextView
        android:id="@+id/tags_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Добавить теги:"
        android:textColor="#5C4033"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/note_text"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Tags Input -->

    <EditText
        android:id="@+id/tags"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search"
        android:hint="#work #friends"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#5C4033"
        android:textColorHint="#995C4033"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tags_question"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Emotion Selector -->

    <RadioGroup
        android:id="@+id/emotions_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintTop_toBottomOf="@id/tags"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/emotion_bad"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_emotion_radio"
            android:button="@null"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="😢\nBad"
            android:textAlignment="center"
            android:textColor="#5C4033"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/emotion_meh"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_emotion_radio"
            android:button="@null"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="😐\nMeh"
            android:textAlignment="center"
            android:textColor="#5C4033"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/emotion_ok"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_emotion_radio"
            android:button="@null"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="😊\nOk"
            android:textAlignment="center"
            android:textColor="#5C4033"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/emotion_nice"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_emotion_radio"
            android:button="@null"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="😄\nNice"
            android:textAlignment="center"
            android:textColor="#5C4033"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/emotion_good"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_emotion_radio"
            android:button="@null"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="🎉\nGood"
            android:textAlignment="center"
            android:textColor="#5C4033"
            android:textSize="14sp" />

    </RadioGroup>

    <!-- Bottom Buttons -->

    <LinearLayout
        android:id="@+id/buttons_del_save_mood"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/button_del_mood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#C97B63"
            android:text="Удалить"
            android:textColor="#FDF5E6"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="#60C97B63" />

        <Button
            android:id="@+id/button_save_mood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#C97B63"
            android:text="Сохранить"
            android:textColor="#FDF5E6"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="#60C97B63" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>