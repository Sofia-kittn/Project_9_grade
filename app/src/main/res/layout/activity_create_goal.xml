<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    tools:context=".goals.CreateGoalActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DECAA5"
    android:padding="@dimen/screen_padding">

    <ImageButton
        android:id="@+id/back_arrow"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_search"
        android:backgroundTint="#FDF5E6"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/new_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="Новая цель"
        android:textColor="#5C4033"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/back_arrow"
        app:layout_constraintBottom_toBottomOf="@id/back_arrow"
        app:layout_constraintStart_toEndOf="@id/back_arrow" />

    <EditText
        android:id="@+id/goal_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape_rounded_input"
        android:gravity="top|start"
        android:hint="Запишите цель..."
        android:inputType="textMultiLine"
        android:minHeight="120dp"
        android:padding="16dp"
        android:textColor="#5C4033"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/buttons_del_save_goal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_goal" />

    <LinearLayout
        android:id="@+id/buttons_del_save_goal"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/goal_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/button_del_goal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#C97B63"
            android:text="Удалить"
            android:textColor="#FDF5E6"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="#60C97B63" />

        <Button
            android:id="@+id/button_save_goal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#C97B63"
            android:text="Сохранить"
            android:textColor="#FDF5E6"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="#60C97B63" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>